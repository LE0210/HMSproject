# Line endings — normalise so every contributor (Windows / macOS / Linux)
# gets the same files and diffs stay clean.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets are never touched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

# The lockfile is generated by npm and must stay consistent.
package-lock.json text eol=lf
